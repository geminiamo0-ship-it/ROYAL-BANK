# Royal Content Manager never stores service-role secrets itself.
# Put this file beside the app as .env, or set these variables in Windows.

ROYAL_DEV_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
ROYAL_DEV_SERVICE_ROLE_KEY=YOUR_DEV_SERVICE_ROLE_KEY

ROYAL_PROD_SUPABASE_URL=https://YOUR-PROD-PROJECT.supabase.co
ROYAL_PROD_SERVICE_ROLE_KEY=YOUR_PROD_SERVICE_ROLE_KEY
